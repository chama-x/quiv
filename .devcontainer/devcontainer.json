{
  "name": "quiv Dev Sandbox",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/bun:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bun install && bun run build",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "biomejs.biome"
      ]
    }
  }
}
